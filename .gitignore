# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated model-weight artifacts; keep JSON manifests and validation reports trackable.
/artifacts/**/*.safetensors

# Generated training weights / optimizer state. JSON and JSONL logs stay trackable.
/checkpoints/**/*.safetensors
/checkpoints/**/*.pt
/outputs/**/*.safetensors
/outputs/**/*.pt
/runs/**/*.safetensors
/runs/**/*.pt
